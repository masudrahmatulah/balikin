# Supabase Database
DATABASE_URL="postgresql://postgres:[password]@[host].supabase.co:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Email OTP (Resend)
RESEND_API_KEY="isi-dari-dashboard-resend"
EMAIL_FROM="Balikin <noreply@balikin.test>"

# Helpdesk AI (server-only, never expose as NEXT_PUBLIC_*)
# Use separate authorized Google projects/accounts for redundancy.
GEMINI_API_KEY_1="isi-dari-Google AI Studio akun/project 1"
GEMINI_API_KEY_2="isi-dari-Google AI Studio akun/project 2"
GEMINI_API_KEY_3="isi-dari-Google AI Studio akun/project 3"
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# WhatsApp OTP (Fonnte API)
# Get your API token from https://fonnte.com
FONNTE_API_TOKEN="isi-dari-dashboard-fonnte"
FONNTE_DEVICE_ID="nomor-wa-device"
FONNTE_BASE_URL="https://api.fonnte.com"

# WhatsApp scan alert routing
WHATSAPP_PROVIDER_STANDARD="fonnte_standard"
WHATSAPP_PROVIDER_PRIORITY="fonnte_priority"

# WhatsApp Order Number
# Nomor WhatsApp untuk menerima pesanan (tanpa + atau 0 di depan, contoh: 6281234567890)
WHATSAPP_ORDER_NUMBER="6281234567890"

# Optional dedicated priority channel for Acrylic Premium
FONNTE_PRIORITY_API_TOKEN=""
FONNTE_PRIORITY_DEVICE_ID=""
FONNTE_PRIORITY_BASE_URL="https://api.fonnte.com"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="balikin-public"
R2_PRIVATE_BUCKET="balikin-private"
R2_PUBLIC_URL="https://cdn.balikin.online"
# Legacy Vercel Blob token is only needed while old URLs are being deleted.
BLOB_READ_WRITE_TOKEN=""
# File Upload\nMAX_UPLOAD_SIZE_MB=5

# Logistik RajaOngkir (Komerce API)
# Daftar & ambil "Shipping Cost" API key di: https://collaborator.komerce.id (Developer > Settings > Api Key)
RAJAONGKIR_API_KEY="your-rajaongkir-api-key-here"
RAJAONGKIR_ORIGIN_CITY_ID="153"

# Pembayaran Komerce Payment API (collaborator.komerce.id)
# Daftar & ambil API key di: https://collaborator.komerce.id (Developer > Settings > Api Key)
# Catatan: jika tidak diisi, otomatis memakai RAJAONGKIR_API_KEY di atas (satu dashboard Komerce)
KOMERCE_PAYMENT_API_KEY="your-komerce-api-key-here"
# "sandbox" untuk development, "production" untuk live
KOMERCE_ENV="sandbox"
# Secret untuk verifikasi callback/webhook (HMAC-SHA256). Isi string acak yang sama antara create & callback.
KOMERCE_PAYMENT_CALLBACK_SECRET="your-komerce-callback-secret-here"
